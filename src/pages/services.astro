---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import { serviceDetails } from '../data/services';

const photoSizes = '(min-width: 1240px) 564px, (min-width: 992px) calc((100vw - 112px) / 2), calc(100vw - 56px)';
---

<Base
  title="Services — Event Photography, Film & Drone | Cinematic Winnipeg"
  description="Photo, film and drone coverage for galas, corporate events, golf tournaments, fundraisers, festivals and carnivals in Winnipeg and across Manitoba."
>
  <section class="section-dark">
    <div class="container intro" data-stagger>
      <p class="eyebrow">Services</p>
      <h1 class="intro__title">Photo, film and drone coverage for events that matter.</h1>
    </div>
  </section>

  {
    serviceDetails.map((service) => (
      <section
        id={service.id}
        class:list={['service', service.theme === 'dark' ? 'section-dark service--dark' : 'section-light']}
      >
        <div class="container service__grid" data-stagger>
          <div class:list={['media service__media', { 'media--dark': service.theme === 'dark' }]}>
            <Photo src={service.photo.src} alt={service.photo.alt} sizes={photoSizes} />
          </div>
          <div class="service__text">
            <span class="num service__num">{service.num}</span>
            <h2 class="service__title">{service.title}</h2>
            <p class="service__body">{service.body}</p>
            <ul class="service__list">
              {service.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
            <a class="btn btn--gold btn--md service__cta" href="/contact">
              Enquire about {service.short}
            </a>
          </div>
        </div>
      </section>
    ))
  }
</Base>

<style>
  .intro {
    padding-top: 110px;
    padding-bottom: 90px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .intro__title {
    margin: 0;
    font-weight: 500;
    font-size: clamp(38px, 5vw, 68px);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--cream);
    max-width: 860px;
  }

  .service {
    --s-ink: var(--ink);
    --s-sub: var(--ink-2);
    --s-rule: var(--rule-light);
    --s-gold: var(--gold-deep);
  }

  .service--dark {
    --s-ink: var(--cream);
    --s-sub: var(--stone);
    --s-rule: var(--rule-dark-2);
    --s-gold: var(--gold);
  }

  .service__grid {
    padding-top: 100px;
    padding-bottom: 100px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 440px), 1fr));
    gap: 56px;
    align-items: center;
  }

  .service__media {
    aspect-ratio: 4 / 3;
  }

  .service__text {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .service__num {
    color: var(--s-gold);
  }

  .service__title {
    margin: 0;
    font-weight: 500;
    font-size: clamp(28px, 3.2vw, 42px);
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--s-ink);
  }

  .service__body {
    margin: 0;
    font-size: 16px;
    line-height: 1.7;
    color: var(--s-sub);
  }

  .service__list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--s-rule);
  }

  .service__list li {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 0;
    border-bottom: 1px solid var(--s-rule);
    font-size: 15px;
    color: var(--s-ink);
  }

  .service__list li::before {
    content: '';
    flex-shrink: 0;
    width: 6px;
    height: 6px;
    background: var(--s-gold);
    transform: rotate(45deg);
  }

  .service__cta {
    align-self: flex-start;
    margin-top: 6px;
  }
</style>
