---
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import { categories } from '../data/portfolio';

const entries = (await getCollection('portfolio')).sort((a, b) => a.data.order - b.data.order);
const work = await Promise.all(
  entries.map(async ({ id, data }) => ({
    id,
    ...data,
    // Larger WebP set for the lightbox (also the no-JS link target).
    full: await getImage({ src: data.image, widths: [1024, 1600, 1920], format: 'webp' }),
  })),
);

const filters = ['All', ...categories];
const tileSizes =
  '(min-width: 1240px) 286px, (min-width: 1138px) calc((100vw - 98px) / 4), (min-width: 864px) calc((100vw - 84px) / 3), (min-width: 590px) calc((100vw - 70px) / 2), calc(100vw - 56px)';
---

<Base
  title="Portfolio — Galas, Corporate Events, Golf & Festivals | Cinematic Winnipeg"
  description="Recent work from Cinematic Winnipeg: galas, corporate events, grand openings, golf tournaments, festivals, carnivals and aerial drone photography in Winnipeg, Manitoba."
>
  <section class="section-light portfolio">
    <div class="container pf">
      <div class="pf__head">
        <p class="eyebrow eyebrow--deep">Portfolio</p>
        <h1 class="pf__title">The work</h1>
      </div>

      <div class="chips" role="group" aria-label="Filter by category">
        {
          filters.map((cat) => (
            <button class="chip" type="button" data-filter={cat} aria-pressed={cat === 'All' ? 'true' : 'false'}>
              {cat}
            </button>
          ))
        }
      </div>

      <ul class="pf-grid" data-stagger>
        {
          work.map((item) => (
            <li class="pf-item" data-cat={item.category}>
              <a
                class="media pf-item__media"
                href={item.full.src}
                data-lightbox-link
                data-srcset={item.full.srcSet.attribute}
                data-title={item.title}
                data-cat={item.category}
              >
                <Photo src={item.image} alt={item.alt} sizes={tileSizes} widths={[640, 1024]} />
              </a>
              <div class="pf-item__meta">
                <span class="pf-item__title">{item.title}</span>
                <span class="pf-item__cat">{item.category}</span>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <dialog class="lightbox" aria-label="Photo viewer" data-lightbox>
    <figure class="lightbox__figure">
      <img class="lightbox__img" alt="" sizes="(min-width: 1200px) 1600px, 100vw" />
      <figcaption class="lightbox__caption">
        <span class="lightbox__title"></span>
        <span class="lightbox__cat"></span>
        <span class="lightbox__count"></span>
      </figcaption>
    </figure>
    <button class="lightbox__btn lightbox__close" type="button" data-close>Close</button>
    <button class="lightbox__btn lightbox__nav lightbox__prev" type="button" aria-label="Previous photo" data-prev
      >←</button
    >
    <button class="lightbox__btn lightbox__nav lightbox__next" type="button" aria-label="Next photo" data-next
      >→</button
    >
  </dialog>
</Base>

<script>
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');

  /* ---------- Filter chips ---------- */

  const chips = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
  const items = [...document.querySelectorAll<HTMLLIElement>('.pf-item')];

  for (const chip of chips) {
    chip.addEventListener('click', () => {
      const cat = chip.dataset.filter;
      for (const c of chips) c.setAttribute('aria-pressed', String(c === chip));

      const visible = items.filter((item) => {
        const show = cat === 'All' || item.dataset.cat === cat;
        item.hidden = !show;
        return show;
      });

      if (!document.documentElement.classList.contains('motion') || reducedMotion.matches) return;
      visible.forEach((item, i) => {
        item.classList.add('in');
        item.animate([{ opacity: 0, transform: 'translateY(32px)' }, { opacity: 1, transform: 'none' }], {
          duration: 1000,
          delay: Math.min(i, 8) * 110,
          easing: 'cubic-bezier(.2,.7,.2,1)',
          fill: 'backwards',
        });
      });
    });
  }

  /* ---------- Lightbox ---------- */

  const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]')!;
  const img = dialog.querySelector<HTMLImageElement>('.lightbox__img')!;
  const title = dialog.querySelector('.lightbox__title')!;
  const cat = dialog.querySelector('.lightbox__cat')!;
  const count = dialog.querySelector('.lightbox__count')!;
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-lightbox-link]')];
  let list: HTMLAnchorElement[] = [];
  let index = 0;

  function show(i: number) {
    index = (i + list.length) % list.length;
    const link = list[index];
    img.srcset = link.dataset.srcset ?? '';
    img.src = link.href;
    img.alt = link.querySelector('img')?.alt ?? '';
    title.textContent = link.dataset.title ?? '';
    cat.textContent = link.dataset.cat ?? '';
    count.textContent = `${index + 1} / ${list.length}`;
  }

  for (const link of links) {
    link.addEventListener('click', (e) => {
      if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;
      e.preventDefault();
      list = links.filter((l) => !l.closest<HTMLElement>('.pf-item')?.hidden);
      show(list.indexOf(link));
      dialog.showModal();
    });
  }

  dialog.querySelector('[data-close]')!.addEventListener('click', () => dialog.close());
  dialog.querySelector('[data-prev]')!.addEventListener('click', () => show(index - 1));
  dialog.querySelector('[data-next]')!.addEventListener('click', () => show(index + 1));
  dialog.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });
  dialog.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') show(index - 1);
    if (e.key === 'ArrowRight') show(index + 1);
  });
</script>

<style>
  .portfolio {
    min-height: 80vh;
  }

  .pf {
    padding-top: 100px;
    padding-bottom: 100px;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .pf__head {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .pf__title {
    margin: 0;
    font-weight: 500;
    font-size: clamp(38px, 5vw, 64px);
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  .chips {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .chip {
    cursor: pointer;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    padding: 11px 18px;
    border-radius: 40px;
    border: 1px solid var(--rule-light-2);
    background: transparent;
    color: var(--ink);
    transition:
      background 0.3s,
      color 0.3s,
      border-color 0.3s;
  }

  .chip:hover {
    border-color: var(--ink);
  }

  .chip[aria-pressed='true'] {
    background: var(--ink);
    color: var(--cream);
    border-color: var(--ink);
  }

  .pf-grid {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 14px;
  }

  .pf-item {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .pf-item[hidden] {
    display: none;
  }

  .pf-item__media {
    aspect-ratio: 4 / 5;
    cursor: zoom-in;
  }

  .pf-item__meta {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
  }

  .pf-item__title {
    font-size: 15px;
    font-weight: 600;
  }

  .pf-item__cat {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gold-deep);
  }

  /* ---------- Lightbox ---------- */

  .lightbox {
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 72px 88px 32px;
    border: 0;
    background: rgba(15, 14, 13, 0.97);
    color: var(--cream);
    overflow: hidden;
  }

  .lightbox[open] {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lightbox::backdrop {
    background: transparent;
  }

  :global(html:has(.lightbox[open])) {
    overflow: hidden;
  }

  .lightbox__figure {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 100%;
    max-height: 100%;
  }

  .lightbox__img {
    max-width: 100%;
    max-height: calc(100vh - 160px);
    max-height: calc(100dvh - 160px);
    width: auto;
    height: auto;
    object-fit: contain;
    background: var(--panel-dark);
  }

  .lightbox__caption {
    display: flex;
    align-items: baseline;
    gap: 16px;
  }

  .lightbox__title {
    font-size: 15px;
    font-weight: 600;
  }

  .lightbox__cat {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gold);
  }

  .lightbox__count {
    margin-left: auto;
    font-size: 12px;
    letter-spacing: 0.06em;
    color: var(--muted);
  }

  .lightbox__btn {
    position: absolute;
    cursor: pointer;
    background: none;
    color: var(--cream);
    border: 1px solid rgba(251, 248, 242, 0.25);
    border-radius: 2px;
    transition: border-color 0.3s, color 0.3s;
  }

  .lightbox__btn:hover {
    border-color: var(--gold);
    color: var(--gold);
  }

  .lightbox__close {
    top: 20px;
    right: 28px;
    padding: 10px 16px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .lightbox__nav {
    top: 50%;
    width: 48px;
    height: 48px;
    margin-top: -24px;
    font-size: 18px;
  }

  .lightbox__prev {
    left: 24px;
  }

  .lightbox__next {
    right: 24px;
  }

  @media (max-width: 759.98px) {
    .lightbox {
      padding: 72px 16px 88px;
    }

    .lightbox__nav {
      top: auto;
      bottom: 20px;
      margin-top: 0;
    }

    .lightbox__prev {
      left: auto;
      right: 84px;
    }

    .lightbox__next {
      right: 28px;
    }

    .lightbox__img {
      max-height: calc(100dvh - 220px);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .lightbox[open] {
      animation: lightbox-in 0.3s ease-out;
    }
  }

  @keyframes lightbox-in {
    from {
      opacity: 0;
    }
  }
</style>
