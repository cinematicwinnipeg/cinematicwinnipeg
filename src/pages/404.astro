---
import Base from '../layouts/Base.astro';
---

<Base
  title="Page Not Found | Cinematic Winnipeg"
  description="The page you're looking for has moved or no longer exists."
  noindex
>
  <section class="section-dark">
    <div class="container lost" data-stagger>
      <p class="eyebrow">404 — Page not found</p>
      <h1 class="lost__title">This page has moved or no longer exists.</h1>
      <div class="lost__actions">
        <a class="btn btn--gold btn--lg" href="/">Back to home</a>
        <a class="btn btn--outline" href="/portfolio">View work</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .lost {
    min-height: 60vh;
    padding-top: 110px;
    padding-bottom: 110px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 28px;
  }

  .lost__title {
    margin: 0;
    font-weight: 500;
    font-size: clamp(38px, 5vw, 68px);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--cream);
    max-width: 860px;
  }

  .lost__actions {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }
</style>
