---
import Logo from './Logo.astro';
import { nav } from '../data/site';

interface Props {
  /** Pathname of the current page, used to mark the active nav link. */
  current: string;
}

const { current } = Astro.props;
const isActive = (href: string) => current === href;
---

<header class="site-header" data-header>
  <div class="container header__inner">
    <Logo variant="header" href="/" />

    <nav class="nav" aria-label="Main">
      {
        nav.map((item) => (
          <a
            class:list={['nav__link', { 'is-active': isActive(item.href) }]}
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
      <a class="btn btn--gold" href="/contact">Book an event</a>
    </nav>

    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="mobile-nav" data-menu-btn>
      <span class="menu-btn__label">Menu</span>
      <span class="menu-btn__icon" aria-hidden="true"></span>
    </button>
  </div>

  <nav class="drawer" id="mobile-nav" aria-label="Mobile" data-drawer>
    <div class="container drawer__inner">
      {
        nav.map((item) => (
          <a
            class:list={['drawer__link', { 'is-active': isActive(item.href) }]}
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
      <a class="btn btn--gold btn--lg drawer__cta" href="/contact">Book an event</a>
    </div>
  </nav>

  <div class="progress" data-progress aria-hidden="true"></div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgba(15, 14, 13, 0.92);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--rule-dark);
  }

  .header__inner {
    padding-top: 18px;
    padding-bottom: 18px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 30px;
    flex-wrap: wrap;
  }

  .nav__link {
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--stone);
    padding: 6px 0;
    border-bottom: 1px solid transparent;
    transition: color 0.3s;
  }

  .nav__link:hover,
  .nav__link.is-active {
    color: var(--cream);
  }

  .nav__link.is-active {
    border-bottom-color: var(--gold);
  }

  .progress {
    position: absolute;
    left: 0;
    bottom: -1px;
    width: 100%;
    height: 1px;
    background: var(--gold);
    transform-origin: 0 50%;
    transform: scaleX(0);
    pointer-events: none;
  }

  /* ---------- Mobile menu (only once JS is running; otherwise the nav simply wraps) ---------- */

  .menu-btn,
  .drawer {
    display: none;
  }

  @media (max-width: 759.98px) {
    :global(.js) .nav {
      display: none;
    }

    :global(.js) .header__inner {
      flex-wrap: nowrap;
    }

    :global(.js) .menu-btn {
      display: inline-flex;
      align-items: center;
      gap: 12px;
      min-height: 40px;
      padding: 0 0 0 8px;
      margin-right: -2px;
      background: none;
      border: 0;
      cursor: pointer;
      color: var(--cream);
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 0.2em;
      text-transform: uppercase;
    }

    .menu-btn__icon,
    .menu-btn__icon::before {
      display: block;
      width: 22px;
      height: 1px;
      background: currentColor;
      transition: transform 0.3s var(--ease-reveal);
    }

    .menu-btn__icon {
      position: relative;
      transform: translateY(-3px);
    }

    .menu-btn__icon::before {
      content: '';
      position: absolute;
      left: 0;
      top: 6px;
    }

    .site-header[data-open] .menu-btn__icon {
      transform: translateY(0) rotate(45deg);
    }

    .site-header[data-open] .menu-btn__icon::before {
      transform: translateY(-6px) rotate(-90deg);
    }

    :global(.js) .drawer {
      display: block;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      max-height: calc(100vh - 100%);
      max-height: calc(100dvh - 100%);
      overflow-y: auto;
      background: var(--ink-black);
      border-bottom: 1px solid var(--rule-dark);
      visibility: hidden;
      opacity: 0;
      transform: translateY(-8px);
      transition:
        opacity 0.3s,
        transform 0.3s var(--ease-reveal),
        visibility 0s 0.3s;
    }

    .site-header[data-open] .drawer {
      visibility: visible;
      opacity: 1;
      transform: none;
      transition:
        opacity 0.3s,
        transform 0.3s var(--ease-reveal);
    }

    .drawer__inner {
      display: flex;
      flex-direction: column;
      padding-top: 8px;
      padding-bottom: 28px;
    }

    .drawer__link {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 18px 0;
      border-bottom: 1px solid var(--rule-dark);
      font-size: 13px;
      font-weight: 500;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--stone);
    }

    .drawer__link.is-active {
      color: var(--cream);
    }

    .drawer__link.is-active::after {
      content: '';
      width: 6px;
      height: 6px;
      background: var(--gold);
      transform: rotate(45deg);
    }

    .drawer__cta {
      margin-top: 28px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .drawer,
    .site-header[data-open] .drawer,
    .menu-btn__icon,
    .menu-btn__icon::before {
      transition: none;
    }
  }
</style>
