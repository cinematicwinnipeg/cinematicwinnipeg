---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/** Responsive AVIF/WebP photo with a JPEG fallback. Lazy-loaded unless told otherwise. */
interface Props {
  src: ImageMetadata;
  alt: string;
  sizes: string;
  widths?: number[];
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
}

const { src, alt, sizes, widths = [640, 1024, 1600], loading = 'lazy', fetchpriority } = Astro.props;
---

<Picture
  src={src}
  alt={alt}
  sizes={sizes}
  widths={widths}
  formats={['avif', 'webp']}
  fallbackFormat="jpg"
  loading={loading}
  decoding={loading === 'eager' ? undefined : 'async'}
  fetchpriority={fetchpriority}
/>
